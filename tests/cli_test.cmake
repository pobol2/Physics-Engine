file(MAKE_DIRECTORY "${OUTPUT_DIR}")

function(expect_failure)
    execute_process(COMMAND "${RUNNER}" ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(result EQUAL 0 OR NOT error MATCHES "Error:")
        message(FATAL_ERROR "Expected a useful failure for ${ARGN}: ${output} ${error}")
    endif()
endfunction()

if(CASE STREQUAL "cli_csv")
    foreach(example IN ITEMS oscillator pendulum)
        set(csv "${OUTPUT_DIR}/${example}.csv")
        execute_process(COMMAND "${RUNNER}" --example ${example} --damping 0.4 --dt 0.01 --duration 0.025
            --sample-every 2 --csv "${csv}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Runner failed: ${error}")
        endif()
        file(STRINGS "${csv}" lines)
        list(LENGTH lines count)
        if(NOT count EQUAL 4)
            message(FATAL_ERROR "Expected header and three endpoint-inclusive samples, got ${count}")
        endif()
        list(GET lines 0 header)
        if(NOT header STREQUAL "time,step,particle,x,y,z,vx,vy,vz,kinetic,potential,total,energy_change,scaled_energy_change,external_work,energy_balance_error,max_position_error,max_velocity_error")
            message(FATAL_ERROR "Unexpected CSV schema: ${header}")
        endif()
        list(GET lines 1 initial)
        list(GET lines 2 middle)
        list(GET lines 3 final)
        if(NOT initial MATCHES "^0,0,0," OR NOT middle MATCHES "^0\\.02[0-9]*,2,0,"
           OR NOT final MATCHES "^0\\.025[0-9]*,3,0,")
            message(FATAL_ERROR "Wrong CSV timing: ${initial} / ${middle} / ${final}")
        endif()
        foreach(row IN ITEMS "${initial}" "${middle}" "${final}")
            string(REPLACE "," ";" cells "${row}")
            list(LENGTH cells columns)
            if(NOT columns EQUAL 18 OR row MATCHES "[Nn][Aa][Nn]|[Ii][Nn][Ff]")
                message(FATAL_ERROR "Invalid CSV values: ${row}")
            endif()
        endforeach()
    endforeach()
    execute_process(COMMAND "${RUNNER}" --duration 0 --csv "${OUTPUT_DIR}/initial.csv" RESULT_VARIABLE result)
    file(STRINGS "${OUTPUT_DIR}/initial.csv" lines)
    list(LENGTH lines count)
    if(NOT result EQUAL 0 OR NOT count EQUAL 2)
        message(FATAL_ERROR "Zero-duration run should export just initial state")
    endif()
    execute_process(COMMAND "${RUNNER}" --dt 0.01 --duration 0.1 --sample-every 10
        --csv "${OUTPUT_DIR}/grid.csv" RESULT_VARIABLE result OUTPUT_VARIABLE output)
    if(NOT result EQUAL 0 OR NOT output MATCHES "time=0\\.1 steps=10 ")
        message(FATAL_ERROR "Runner added a round-off endpoint step: ${output}")
    endif()
    # Adaptive runs land on the output grid with any number of internal steps.
    execute_process(COMMAND "${RUNNER}" --example kepler --integrator adaptive --rtol 1e-10 --atol 1e-10
        --dt 0.5 --duration 2 --csv "${OUTPUT_DIR}/adaptive.csv" RESULT_VARIABLE result OUTPUT_VARIABLE output)
    file(STRINGS "${OUTPUT_DIR}/adaptive.csv" lines)
    list(LENGTH lines count)
    list(GET lines 5 final)
    if(NOT result EQUAL 0 OR NOT count EQUAL 6 OR NOT final MATCHES "^2,[0-9]+,0," OR NOT output MATCHES "rejected=")
        message(FATAL_ERROR "Adaptive CSV output is wrong: ${output}")
    endif()
    execute_process(COMMAND "${RUNNER}" --example double-pendulum --duration 0.1 --csv "${OUTPUT_DIR}/two.csv"
        RESULT_VARIABLE result)
    file(STRINGS "${OUTPUT_DIR}/two.csv" lines)
    list(GET lines 1 first)
    list(GET lines 2 second)
    if(NOT result EQUAL 0 OR NOT first MATCHES "^0,0,0," OR NOT second MATCHES "^0,0,1,")
        message(FATAL_ERROR "Multi-particle CSV needs one row per particle")
    endif()
    execute_process(COMMAND "${RUNNER}" --list RESULT_VARIABLE result OUTPUT_VARIABLE output)
    foreach(example IN ITEMS oscillator pendulum driven-oscillator parametric-oscillator kapitza-pendulum
                             double-pendulum folded-chain rotating-hoop kepler three-body cyclotron)
        if(NOT result EQUAL 0 OR NOT output MATCHES "${example}: ")
            message(FATAL_ERROR "--list does not describe ${example}")
        endif()
    endforeach()
elseif(CASE STREQUAL "cli_errors")
    expect_failure(--dt 0)
    expect_failure(--dt nan)
    expect_failure(--duration -1)
    expect_failure(--mass 0)
    expect_failure(--damping -0.1)
    expect_failure(--damping nan)
    expect_failure(--damping inf)
    expect_failure(--stiffness 4junk)
    expect_failure(--example missing)
    expect_failure(--example pendulum --displacement 1)
    expect_failure(--example oscillator --angle 1)
    expect_failure(--example folded-chain --links 2.5)
    expect_failure(--sample-every -1)
    expect_failure(--sample-every 0)
    expect_failure(--sample-every 1.5)
    expect_failure(--unknown value)
    expect_failure(--length)
    expect_failure(--csv "${OUTPUT_DIR}/missing/directory/output.csv")
    expect_failure(--integrator euler)
    expect_failure(--integrator adaptive --rtol 0 --atol 0)
    expect_failure(--integrator adaptive --rtol -1)
    expect_failure(--example pendulum --eccentricity 0.5)
    expect_failure(--example kepler --eccentricity 1)
    expect_failure(--example parametric-oscillator --modulation 1.5)
else()
    message(FATAL_ERROR "Unknown CLI test case")
endif()
